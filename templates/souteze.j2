      <!-- 2016 -->
      <div class="result-card fade-in" data-year="2016">
        <span class="result-year">2016</span>
        <p class="result-name">OHS Okrsek</p>
        <p class="result-meta">Kategorie: <strong>Ženy</strong></p>
        <p class="result-meta">Ženský tým se aktivně účastnil okrskových soutěží.</p>
      </div>

      <div class="result-card fade-in" data-year="2016">
        <span class="result-year">2016</span>
