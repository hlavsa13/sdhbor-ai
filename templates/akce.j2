<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Akce a brigády — SDH Bor u Sedlčan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=Special+Elite&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root { --paper: #f2ece0; --pale: #f8f3e8; --ink: #1a1209; --dark: #1a0f05; --copper: #c8702a; --tan: #c8a882; --muted: #8b6543; --pale-bg: #f5ead8; }
html { scroll-behavior: smooth; }
body { background: var(--paper); color: var(--ink); font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; line-height: 1.7; }
nav { background: var(--dark); position: sticky; top: 0; z-index: 100; border-bottom: 3px solid var(--copper); }
.nav-inner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; height: 64px; }
.nav-logo { font-family: 'IM Fell English SC', serif; font-size: 1.3rem; letter-spacing: 0.04em; color: var(--copper); text-decoration: none; }
.nav-links { display: flex; gap: 0; list-style: none; }
.nav-links a { font-family: 'Special Elite', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--tan); text-decoration: none; padding: 0.5rem 0.9rem; transition: color 0.2s; border-right: 1px solid rgba(200,168,130,0.15); }
.nav-links li:first-child a { border-left: 1px solid rgba(200,168,130,0.15); }
.nav-links a:hover, .nav-links a.active { color: var(--copper); }
.nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; flex-direction: column; gap: 5px; }
.nav-toggle span { display: block; width: 24px; height: 2px; background: var(--tan); }

.page-header { background: var(--dark); text-align: center; padding: 3rem 1rem 2rem; border-bottom: 4px double var(--copper); position: relative; overflow: hidden; }
.page-header::before { content: 'AKCE'; font-family: 'IM Fell English SC', serif; font-size: 25vw; color: rgba(200,112,42,0.04); position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); pointer-events: none; white-space: nowrap; }
.eyebrow { font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.6rem; }
.page-header h1 { font-family: 'IM Fell English SC', serif; font-size: clamp(1.8rem, 5vw, 3.8rem); color: var(--copper); line-height: 1.2; letter-spacing: 0.02em; }
.page-header .sub { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.1rem; color: var(--tan); margin-top: 0.5rem; }
.rule-divider { height: 12px; background: repeating-linear-gradient(to bottom, var(--tan) 0, var(--tan) 1px, transparent 1px, transparent 6px, var(--tan) 6px, var(--tan) 7px, transparent 7px, transparent 12px); opacity: 0.35; }
.container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
.section { padding: 4.5rem 0; }
.paper-bg { background-color: var(--paper); background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23c8a882' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E"); }
.dark-bg { background-color: var(--dark); color: var(--pale-bg); }

/* SECTION HEADINGS */
.section-label { font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--copper); display: block; margin-bottom: 0.5rem; }
.section-title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 900; line-height: 1.15; color: var(--ink); }
.dark-bg .section-title { color: var(--pale-bg); }
.section-ornament { display: block; color: var(--copper); font-size: 1rem; margin: 0.6rem 0 2.5rem; letter-spacing: 0.4em; }

/* EVENT CARDS */
.events-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.event-card { background: var(--pale-bg); border: 1px solid var(--tan); outline: 2px solid var(--tan); outline-offset: -6px; padding: 1.8rem; position: relative; transition: transform 0.2s; }
.event-card:hover { transform: translateY(-3px); }
.event-type { font-family: 'Special Elite', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--copper); display: block; margin-bottom: 0.4rem; }
.event-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--ink); margin-bottom: 0.6rem; line-height: 1.3; }
.event-date { font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.12em; color: var(--muted); margin-bottom: 0.8rem; }
.event-desc { font-size: 0.87rem; color: var(--muted); line-height: 1.6; }
.event-stamp { margin-top: 1.2rem; display: inline-block; font-family: 'Special Elite', monospace; font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; background: var(--copper); color: var(--pale-bg); padding: 0.2rem 0.6rem; border: 1px solid var(--dark); }

/* BRIGADES */
.brigade-table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
.brigade-table thead tr { border-bottom: 2px solid var(--copper); }
.brigade-table th { font-family: 'Special Elite', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--tan); text-align: left; padding: 0.7rem 1rem; }
.brigade-table td { font-size: 0.88rem; color: var(--pale-bg); padding: 0.8rem 1rem; border-bottom: 1px solid rgba(200,168,130,0.15); vertical-align: top; }
.dark-bg .brigade-table td { color: var(--pale-bg); }
.brigade-table tr:hover td { background: rgba(200,112,42,0.05); }
.brigade-date { font-family: 'Special Elite', monospace; font-size: 0.7rem; letter-spacing: 0.1em; color: var(--copper); }
.brigade-members { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.3rem; }
.member-tag { font-family: 'Special Elite', monospace; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; border: 1px solid rgba(200,168,130,0.4); padding: 0.15rem 0.4rem; color: rgba(245,234,216,0.6); }
.hours-badge { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; color: var(--copper); }

/* ANNUAL EVENTS */
.annual-row { display: flex; gap: 2rem; flex-wrap: wrap; }
.annual-item { flex: 1; min-width: 240px; border-left: 3px solid var(--copper); padding: 1rem 1.5rem; }
.annual-title { font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700; color: var(--ink); margin-bottom: 0.3rem; }
.annual-desc { font-size: 0.85rem; color: var(--muted); }

footer { background: var(--dark); color: var(--tan); padding: 2.5rem 0 1.5rem; border-top: 4px double var(--copper); }
.footer-inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 2rem; }
.footer-logo { font-family: 'IM Fell English SC', serif; font-size: 1.7rem; letter-spacing: 0.03em; color: var(--copper); }
.footer-nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
.footer-nav a { font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tan); text-decoration: none; }
.footer-nav a:hover { color: var(--copper); }
.footer-bottom { max-width: 1100px; margin: 1.5rem auto 0; padding: 1rem 2rem 0; border-top: 1px solid rgba(200,168,130,0.2); font-family: 'Special Elite', monospace; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-align: center; }

.fade-in { opacity: 0; transform: translateY(15px); transition: opacity 0.6s ease, transform 0.6s ease; }
.fade-in.visible { opacity: 1; transform: none; }

@media (max-width: 900px) { .events-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) {
  .events-grid { grid-template-columns: 1fr; }
  .nav-links { display: none; flex-direction: column; position: absolute; top: 64px; left: 0; right: 0; background: var(--dark); padding: 1rem 0; border-bottom: 3px solid var(--copper); }
  .nav-links.open { display: flex; }
  .nav-links a { border: none !important; padding: 0.6rem 2rem; }
  .nav-toggle { display: flex; }
  .brigade-table td:last-child { display: none; }
}
</style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <a href="index.html" class="nav-logo">SDH Bor</a>
    <ul class="nav-links" id="navLinks">
      <li><a href="index.html#o-nas">O nás</a></li>
      <li><a href="historie.html">Historie</a></li>
      <li><a href="souteze.html">Soutěže</a></li>
      <li><a href="akce.html" class="active">Akce</a></li>
      <li><a href="clenove.html">Členové</a></li>
      <li><a href="index.html#kontakt">Kontakt</a></li>
    </ul>
    <button class="nav-toggle" id="navToggle"><span></span><span></span><span></span></button>
  </div>
</nav>

<header class="page-header">
  <p class="eyebrow">SDH Bor u Sedlčan</p>
  <h1>Akce a brigády</h1>
  <p class="sub">Společenský a pracovní život sboru</p>
</header>
<div class="rule-divider"></div>

<!-- PRAVIDELNÉ AKCE -->
<section class="section paper-bg">
  <div class="container">
    <div style="text-align:center; margin-bottom:3rem;" class="fade-in">
      <span class="section-label">Každoroční dění</span>
      <h2 class="section-title">Pravidelné akce</h2>
      <span class="section-ornament">✦ ✦ ✦</span>
    </div>
    <div class="events-grid">
      <div class="event-card fade-in">
        <span class="event-type">Výroční</span>
        <h3 class="event-title">Valná hromada SDH</h3>
        <p class="event-date">Každoročně — leden/únor</p>
        <p class="event-desc">Výroční schůze sboru, hodnocení uplynulého roku, volba vedení a plánování dalšího roku. Nejdůležitější shromáždění roku.</p>
      </div>
      <div class="event-card fade-in">
        <span class="event-type">Tradiční</span>
        <h3 class="event-title">Hasičský ples</h3>
        <p class="event-date">Každoročně — zimní měsíce</p>
        <p class="event-desc">Tradiční společenská událost pro členy sboru, jejich rodiny a přátele z obce. Živá hudba, tombola a hasičská pohostinnost.</p>
      </div>
      <div class="event-card fade-in">
        <span class="event-type">Místní</span>
        <h3 class="event-title">Pálení čarodějnic</h3>
        <p class="event-date">30. dubna každoročně</p>
        <p class="event-desc">Sbor organizuje oblíbenou jarní slavnost pro celou obec. Táborák, zábava pro děti, opékání a přátelské setkání sousedů.</p>
      </div>
      <div class="event-card fade-in">
        <span class="event-type">Svátky</span>
        <h3 class="event-title">Výročí sboru</h3>
        <p class="event-date">29. července (výroční)</p>
        <p class="event-desc">Každoroční připomenutí vzniku sboru k datu 29. července 1906. Při kulatých výročích slavnostní setkání s hosty z okolních sborů.</p>
      </div>
      <div class="event-card fade-in">
        <span class="event-type">Soutěžní</span>
        <h3 class="event-title">Okrsková soutěž OHS</h3>
        <p class="event-date">Červen–srpen, každoročně</p>
        <p class="event-desc">Sbor vysílá soutěžní družstva mužů, žen a mládežníků na okrskové požárnické soutěže. Závodí se v útoku na čas.</p>
      </div>
      <div class="event-card fade-in">
        <span class="event-type">Schůze</span>
        <h3 class="event-title">Schůze výboru</h3>
        <p class="event-date">Pravidelně po celý rok</p>
        <p class="event-desc">Pravidelná setkání vedení sboru — příprava akcí, řešení provozních záležitostí, brigád a soutěžních přihlášek.</p>
      </div>
    </div>
  </div>
</section>

<div class="rule-divider"></div>

<!-- BRIGÁDY -->
<section class="section dark-bg">
  <div class="container">
    <div style="text-align:center; margin-bottom:3rem;" class="fade-in">
      <span class="section-label" style="color:var(--tan);">Práce pro obec</span>
      <h2 class="section-title">Brigádnická činnost</h2>
      <span class="section-ornament" style="color:var(--tan);">✦ ✦ ✦</span>
    </div>
    <p class="fade-in" style="font-size:0.95rem; color:rgba(245,234,216,0.7); max-width:700px; margin:0 auto 2.5rem; text-align:center; font-style:italic;">"Sbor vykonává brigádnické práce v obci nejen v době nouze, ale i preventivně — údržba, příprava a pomoc spoluobčanům."</p>

    <table class="brigade-table fade-in">
      <thead>
        <tr>
          <th>Datum</th>
          <th>Popis brigády</th>
          <th>Odprac. hodin</th>
          <th>Účastníci</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="brigade-date">14. 1. 2018</span></td>
          <td>
            <strong style="font-family:'Playfair Display',serif; color:var(--pale-bg);">Odvoz šrotu</strong>
            <div class="brigade-members">
              <span class="member-tag">Pešta V. ml.</span>
              <span class="member-tag">Spilka V. ml.</span>
              <span class="member-tag">Všetečka J.</span>
              <span class="member-tag">Pešta J.</span>
              <span class="member-tag">Ambrož J.</span>
              <span class="member-tag">Dvořák M.</span>
              <span class="member-tag">Novák J.</span>
              <span class="member-tag">Tůma R.</span>
              <span class="member-tag">Kovář D.</span>
              <span class="member-tag">Strnad J.</span>
              <span class="member-tag">Holý R.</span>
            </div>
          </td>
          <td><span class="hours-badge">16,5</span><br><small style="font-family:'Special Elite',monospace; font-size:0.6rem; letter-spacing:0.1em; color:var(--tan);">hodin celkem</small></td>
          <td style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:700; color:var(--copper);">11</td>
        </tr>
        <tr>
          <td><span class="brigade-date">13. 1. 2018</span></td>
          <td>
            <strong style="font-family:'Playfair Display',serif; color:var(--pale-bg);">Příprava kamení pro čekárnu</strong>
            <div class="brigade-members">
              <span class="member-tag">Pešta V. ml.</span>
              <span class="member-tag">Spilka V. ml.</span>
              <span class="member-tag">Všetečka J.</span>
              <span class="member-tag">Pešta J.</span>
              <span class="member-tag">Ambrož J.</span>
              <span class="member-tag">Dvořák M.</span>
              <span class="member-tag">Novák J.</span>
              <span class="member-tag">Tůma R.</span>
              <span class="member-tag">Kovář D.</span>
              <span class="member-tag">Strnad J.</span>
              <span class="member-tag">Holý R.</span>
              <span class="member-tag">Hora J.</span>
            </div>
          </td>
          <td><span class="hours-badge">30</span><br><small style="font-family:'Special Elite',monospace; font-size:0.6rem; letter-spacing:0.1em; color:var(--tan);">hodin celkem</small></td>
          <td style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:700; color:var(--copper);">12</td>
        </tr>
        <tr>
          <td><span class="brigade-date">Pravidelně</span></td>
          <td>
            <strong style="font-family:'Playfair Display',serif; color:var(--pale-bg);">Údržba zbrojnice a okolí</strong>
            <p style="font-size:0.83rem; color:rgba(245,234,216,0.6); margin-top:0.3rem;">Pravidelné úklidové a údržbové práce u zbrojnice a v okolí — sekání trávy, úklid, drobné opravy.</p>
          </td>
          <td><span class="hours-badge">—</span></td>
          <td style="font-family:'Special Elite',monospace; font-size:0.7rem; letter-spacing:0.1em; color:var(--tan);">celý sbor</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <span class="footer-logo">SDH Bor</span>
    <nav class="footer-nav">
      <a href="index.html">Úvod</a>
      <a href="historie.html">Historie</a>
      <a href="souteze.html">Soutěže</a>
      <a href="akce.html">Akce</a>
      <a href="clenove.html">Členové</a>
      <a href="index.html#kontakt">Kontakt</a>
    </nav>
  </div>
  <div class="footer-bottom">© 2024 SDH Bor u Sedlčan &nbsp;✦&nbsp; Zal. 29. července 1906</div>
</footer>

<script>
document.getElementById('navToggle').addEventListener('click', () => document.getElementById('navLinks').classList.toggle('open'));
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }});
}, { threshold: 0.1 });
document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
</body>
