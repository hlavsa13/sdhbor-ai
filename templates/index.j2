<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SDH Bor u Sedlčan — Sbor dobrovolných hasičů</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=Special+Elite&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --paper: #f2ece0; --pale: #f8f3e8; --ink: #1a1209; --dark: #1a0f05;
  --copper: #c8702a; --tan: #c8a882; --muted: #8b6543; --pale-bg: #f5ead8;
}
html { scroll-behavior: smooth; }
body { background: var(--paper); color: var(--ink); font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; line-height: 1.7; }

/* NAV */
nav { background: var(--dark); position: sticky; top: 0; z-index: 100; border-bottom: 3px solid var(--copper); }
.nav-inner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; height: 64px; }
.nav-logo { font-family: 'IM Fell English SC', serif; font-size: 1.3rem; letter-spacing: 0.04em; color: var(--copper); text-decoration: none; }
.nav-links { display: flex; gap: 0; list-style: none; }
.nav-links a { font-family: 'Special Elite', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--tan); text-decoration: none; padding: 0.5rem 0.9rem; transition: color 0.2s; border-right: 1px solid rgba(200,168,130,0.15); }
.nav-links li:first-child a { border-left: 1px solid rgba(200,168,130,0.15); }
.nav-links a:hover { color: var(--copper); }
.nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; flex-direction: column; gap: 5px; }
.nav-toggle span { display: block; width: 24px; height: 2px; background: var(--tan); }

/* MASTHEAD */
.masthead { background: var(--dark); text-align: center; padding: 3rem 1rem 2rem; border-bottom: 4px double var(--copper); position: relative; overflow: hidden; background-image: url('foto-uvod.jpg'); background-size: cover; background-position: center 30%; }
.masthead::before { content: ''; position: absolute; inset: 0; background: rgba(26,15,5,0.72); pointer-events: none; }
.masthead > * { position: relative; z-index: 1; }
.masthead-eyebrow { font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.8rem; }
.masthead-title { font-family: 'IM Fell English SC', serif; font-size: clamp(2rem, 5.5vw, 4.2rem); color: var(--copper); line-height: 1.15; letter-spacing: 0.04em; font-style: normal; }
.masthead-rule { width: 60%; height: 1px; background: var(--copper); margin: 0.8rem auto; opacity: 0.35; }
.masthead-subtitle { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(0.95rem, 2vw, 1.15rem); color: var(--tan); margin-bottom: 1rem; }
.masthead-meta { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.18em; color: var(--muted); display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; }
.masthead-meta span::before { content: '✦ '; color: var(--copper); }

/* RULE DIVIDER */
.rule-divider { height: 12px; background: repeating-linear-gradient(to bottom, var(--tan) 0, var(--tan) 1px, transparent 1px, transparent 6px, var(--tan) 6px, var(--tan) 7px, transparent 7px, transparent 12px); opacity: 0.35; }

/* LAYOUT */
.container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
.section { padding: 5rem 0; }

/* PAPER BG */
.paper-bg { background-color: var(--paper); background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23c8a882' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E"); }
.dark-bg { background-color: var(--dark); color: var(--pale-bg); }

/* SECTION HEADINGS */
.section-heading { text-align: center; margin-bottom: 3rem; }
.section-label { font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--copper); display: block; margin-bottom: 0.5rem; }
.section-title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; line-height: 1.15; }
.dark-bg .section-title { color: var(--pale-bg); }
.section-ornament { display: block; color: var(--copper); font-size: 1rem; margin: 0.6rem 0; letter-spacing: 0.4em; }

/* STATS BAR */
.stats-bar { background: var(--copper); padding: 2rem 0; }
.stats-inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
.stat-item { text-align: center; padding: 0.5rem 1rem; border-right: 1px solid rgba(245,234,216,0.3); }
.stat-item:last-child { border-right: none; }
.stat-num { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: var(--pale-bg); display: block; line-height: 1; }
.stat-label { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(245,234,216,0.75); margin-top: 0.3rem; display: block; }

/* HERO / O NÁS */
.hero-section { padding: 5rem 0; }
.hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
.hero-emblem { display: flex; flex-direction: column; align-items: center; }
.emblem-frame { width: 260px; height: 260px; border: 2px solid var(--copper); outline: 6px solid var(--tan); outline-offset: -14px; display: flex; align-items: center; justify-content: center; position: relative; background: var(--pale-bg); }
.emblem-svg { width: 160px; height: 160px; opacity: 0.85; }
.emblem-year { font-family: 'Special Elite', monospace; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-top: 1rem; }

.hero-text .section-title { text-align: left; margin-bottom: 1.2rem; }
.hero-text p { color: var(--muted); margin-bottom: 1rem; font-size: 0.95rem; }
.hero-text p strong { color: var(--ink); font-weight: 700; }
.ornament-bar { color: var(--copper); letter-spacing: 0.5em; margin: 1.5rem 0; font-size: 0.85rem; }
.feature-list { list-style: none; margin-top: 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
.feature-list li { font-family: 'Special Elite', monospace; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--copper); padding-left: 1rem; position: relative; }
.feature-list li::before { content: '✦'; position: absolute; left: 0; font-size: 0.55rem; top: 0.1em; }

/* CARDS */
.card { background: var(--pale-bg); border: 1px solid var(--tan); outline: 2px solid var(--tan); outline-offset: -6px; padding: 1.8rem; }
.card-label { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--copper); display: block; margin-bottom: 0.5rem; }
.card h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: var(--ink); margin-bottom: 0.7rem; line-height: 1.3; }
.card p { font-size: 0.88rem; color: var(--muted); line-height: 1.6; }
.card .stamp { margin-top: 1.2rem; display: inline-block; }

/* STAMP */
.stamp { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; background: var(--copper); color: var(--pale-bg); padding: 0.25rem 0.7rem; border: 1px solid var(--dark); transform: rotate(-1.5deg); display: inline-block; }
.stamp.gold { background: transparent; color: var(--copper); border-color: var(--copper); border-width: 2px; transform: rotate(1deg); }

/* BUTTON */
.btn { display: inline-block; font-family: 'Special Elite', monospace; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; padding: 0.7rem 1.6rem; border: 2px solid var(--copper); color: var(--copper); background: transparent; cursor: pointer; transition: background 0.2s, color 0.2s; }
.btn:hover { background: var(--copper); color: var(--pale-bg); }
.btn-filled { background: var(--copper); color: var(--pale-bg); }
.btn-filled:hover { background: var(--dark); border-color: var(--dark); }

/* TIMELINE TEASER */
.timeline-teaser { position: relative; padding-left: 2.5rem; }
.timeline-teaser::before { content: ''; position: absolute; left: 0.65rem; top: 0; bottom: 0; width: 1px; background: var(--copper); opacity: 0.4; }
.timeline-item { position: relative; margin-bottom: 2rem; }
.timeline-item::before { content: ''; position: absolute; left: -1.9rem; top: 0.45rem; width: 8px; height: 8px; background: var(--copper); border: 2px solid var(--pale-bg); border-radius: 50%; box-shadow: 0 0 0 1px var(--copper); }
.timeline-year { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.2em; color: var(--copper); display: block; margin-bottom: 0.2rem; }
.dark-bg .timeline-year { color: var(--tan); }
.timeline-text { font-size: 0.9rem; color: var(--muted); }
.dark-bg .timeline-text { color: rgba(245,234,216,0.7); }
.timeline-title { font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700; color: var(--ink); line-height: 1.3; margin-bottom: 0.2rem; }
.dark-bg .timeline-title { color: var(--pale-bg); }

/* GRID LAYOUTS */
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }

/* TEASER SECTIONS */
.teaser-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; align-items: center; }
.teaser-number { font-family: 'Playfair Display', serif; font-size: clamp(5rem, 12vw, 10rem); font-weight: 900; color: rgba(200,112,42,0.12); line-height: 0.85; }
.teaser-cta { display: flex; align-items: center; gap: 3rem; }

/* CONTACT */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
.contact-info dt { font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--copper); margin-top: 1.2rem; margin-bottom: 0.2rem; }
.contact-info dd { font-size: 0.95rem; color: var(--ink); }
.contact-form label { display: block; font-family: 'Special Elite', monospace; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--copper); margin-bottom: 0.3rem; margin-top: 1.2rem; }
.contact-form input, .contact-form textarea, .contact-form select { width: 100%; background: var(--pale-bg); border: 1px solid var(--tan); border-bottom: 2px solid var(--copper); padding: 0.6rem 0.8rem; font-family: 'Libre Baskerville', serif; font-size: 0.88rem; color: var(--ink); outline: none; transition: border-color 0.2s; }
.contact-form input:focus, .contact-form textarea:focus { border-color: var(--copper); background: #fff; }
.contact-form textarea { min-height: 130px; resize: vertical; }

/* LEADERSHIP CARDS */
.leader-card { text-align: center; }
.leader-card .role { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--copper); margin-bottom: 0.4rem; display: block; }
.leader-card .name { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--pale-bg); }
.dark-bg .leader-card .name { color: var(--pale-bg); }
.leader-icon { width: 72px; height: 72px; margin: 0 auto 1rem; border: 2px solid var(--copper); display: flex; align-items: center; justify-content: center; background: rgba(200,112,42,0.1); }
.leader-icon svg { width: 36px; height: 36px; fill: var(--copper); }

/* EVENT CARDS */
.event-card { border-left: 3px solid var(--copper); padding: 1.2rem 1.5rem; background: var(--pale-bg); margin-bottom: 0.1rem; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
.event-date { font-family: 'Special Elite', monospace; font-size: 0.7rem; letter-spacing: 0.12em; color: var(--copper); white-space: nowrap; }
.event-title { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 0.2rem; }
.event-desc { font-size: 0.83rem; color: var(--muted); }

/* FOOTER */
footer { background: var(--dark); color: var(--tan); padding: 3rem 0 1.5rem; border-top: 4px double var(--copper); }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; margin-bottom: 2rem; }
.footer-logo { font-family: 'IM Fell English SC', serif; font-size: 1.8rem; letter-spacing: 0.03em; color: var(--copper); display: block; margin-bottom: 0.5rem; line-height: 1; }
.footer-tagline { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); }
.footer-col h4 { font-family: 'Special Elite', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--copper); margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(200,168,130,0.2); }
.footer-links { list-style: none; }
.footer-links a { font-family: 'Special Elite', monospace; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tan); text-decoration: none; line-height: 2.2; display: block; }
.footer-links a:hover { color: var(--copper); }
.footer-bottom { border-top: 1px solid rgba(200,168,130,0.2); padding-top: 1rem; font-family: 'Special Elite', monospace; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-align: center; }
.footer-contact p { font-family: 'Special Elite', monospace; font-size: 0.7rem; letter-spacing: 0.05em; color: var(--tan); line-height: 2; }

/* SCROLL TOP */
.scroll-top { position: fixed; bottom: 2rem; right: 2rem; width: 42px; height: 42px; background: var(--copper); border: none; cursor: pointer; color: var(--pale-bg); font-size: 1.2rem; display: none; align-items: center; justify-content: center; z-index: 50; transition: background 0.2s; }
.scroll-top:hover { background: var(--dark); }
.scroll-top.visible { display: flex; }

/* ANIMATE */
.fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.7s ease, transform 0.7s ease; }
.fade-in.visible { opacity: 1; transform: none; }

/* RESPONSIVE */
@media (max-width: 900px) {
  .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .hero-grid, .teaser-grid, .contact-grid, .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
  .teaser-cta { flex-direction: column; align-items: flex-start; gap: 1rem; }
  .stats-inner { grid-template-columns: repeat(2, 1fr); }
  .stat-item:nth-child(2) { border-right: none; }
}
@media (max-width: 600px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  .nav-links { display: none; flex-direction: column; position: absolute; top: 64px; left: 0; right: 0; background: var(--dark); padding: 1rem 0; border-bottom: 3px solid var(--copper); }
  .nav-links.open { display: flex; }
  .nav-links a { border: none !important; padding: 0.6rem 2rem; }
  .nav-toggle { display: flex; }
  .emblem-frame { width: 200px; height: 200px; }
}
</style>
</head>
